          }
        },
        {
          "name": "List charges made through a payment link",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payment-links/{{id}}/charges",
              "host": [
                "{{baseUrl}}"
              ],
