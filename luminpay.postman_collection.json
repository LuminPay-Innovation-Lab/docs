          }
        },
        {
          "name": "Turn a payment link on or off",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payment-links/{{id}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payment-links",
                "{{id}}",
                "status"
              ]
            },
            "description": "Turn a payment link on or off",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"inactive\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Invoices",
      "item": [
