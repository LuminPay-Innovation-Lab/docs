              "raw": "{{baseUrl}}/payment-links",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payment-links"
              ]
            },
            "description": "Create a payment link",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Haircut\",\n  \"amountType\": \"fixed\",\n  \"fixedAmountNgn\": \"5000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List payment links",
          "request": {
            "method": "GET",
