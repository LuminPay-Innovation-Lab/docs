  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "lmp_test_... or lmp_live_...",
        "description": "Your secret API key from Developers → API keys."
      }
    },
    "schemas": {
      "CreateChargeRequest": {
        "type": "object",
        "required": [
          "asset"
        ],
        "properties": {
          "asset": {
            "type": "string",
            "description": "Coin to quote in. See Networks.",
            "example": "USDT_BSC_MAINNET",
            "enum": [
              "USDT_BSC_MAINNET",
              "USDT_TRON_MAINNET",
              "USDT_SOLANA_MAINNET",
              "USDC_ETH_MAINNET",
              "USDC_SOLANA_MAINNET",
              "BTC_MAINNET",
              "USDC_ETH_TEST5_AN74",
              "USDT_BSC_TEST",
              "USDC_SOLANA_DEVNET",
              "BTC_TEST"
            ]
          },
          "amountNgn": {
            "type": "string",
            "pattern": "^[1-9]\\d{0,11}$",
            "description": "Whole naira, digits only. Send this or amount.",
            "example": "25000"
          },
          "amount": {
            "type": "string",
            "pattern": "^[1-9]\\d{0,17}$",
            "description": "Coin amount in its smallest unit. Send this or amountNgn."
          },
          "reference": {
            "type": "string",
            "description": "Your id for this payment. Reusing it returns the same charge.",
            "example": "acme_order_1001"
          }
        }
      },
      "PaymentAddress": {
        "type": "object",
        "properties": {
          "asset": {
            "type": "string"
          },
          "chain": {
            "type": "string",
            "example": "bsc_mainnet"
          },
          "address": {
            "type": "string"
          },
          "amount": {
            "type": "string",
            "description": "Smallest unit"
          },
          "scale": {
            "type": "integer",
            "description": "Decimals",
            "example": 18
          }
        }
      },
      "Charge": {
        "type": "object",
        "properties": {
          "chargeId": {
            "type": "string",
            "format": "uuid"
          },
          "reference": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "paid",
              "underpaid",
              "expired",
              "failed",
              "cancelled"
            ]
          },
          "asset": {
            "type": "string"
          },
          "amount": {
            "type": "string",
            "description": "What the customer pays, smallest unit, fee included"
          },
          "feeAmount": {
            "type": "string",
            "description": "LuminPay fee inside amount"
          },
          "amountNgn": {
            "type": "string",
            "nullable": true,
            "description": "Naira amount in kobo"
          },
          "rate": {
            "type": "string",
            "nullable": true,
            "description": "Naira per US dollar"
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "addresses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentAddress"
            }
          },
          "txHash": {
            "type": "string",
            "nullable": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ChargeList": {
        "type": "object",
        "properties": {
          "transactions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CreateWebhookEndpointRequest": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com/webhooks/luminpay"
          }
        }
      },
      "WebhookEndpoint": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string"
          },
          "signingSecret": {
            "type": "string",
            "example": "whsec_..."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SetWebhookStatusRequest": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled"
            ]
          }
        }
      },
      "WebhookDelivery": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "eventType": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "delivered",
              "failed"
            ]
          },
          "attempts": {
            "type": "integer"
          },
          "responseStatus": {
            "type": "integer",
            "nullable": true
          },
          "responseBody": {
            "type": "string",
            "nullable": true
          },
          "nextRetryAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "deliveredAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "payload": {
            "type": "object"
          }
        }
      },
      "CreatePaymentLinkRequest": {
        "type": "object",
        "required": [
          "title",
          "amountType"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "amountType": {
            "type": "string",
            "enum": [
              "fixed",
              "flexible"
            ]
          },
          "fixedAmountNgn": {
            "type": "string",
            "pattern": "^[1-9]\\d{0,11}$",
            "description": "Whole naira; required when amountType is fixed"
          },
          "successRedirectUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "SetPaymentLinkStatusRequest": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ]
          }
