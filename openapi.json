{
  "openapi": "3.0.3",
  "info": {
    "title": "LuminPay API",
    "version": "1.0.0",
    "description": "Accept stablecoin and Bitcoin payments and settle in naira. Use a lmp_test_ key with the Sandbox server and a lmp_live_ key with the Live server."
  },
  "servers": [
    {
      "url": "https://sandbox-api.luminpay.co",
      "description": "Sandbox (testnet)"
    },
    {
      "url": "https://api.luminpay.co",
      "description": "Live"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
